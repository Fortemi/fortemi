  "clients": [
    {
      "clientId": "fortemi",
      "name": "Fortemi API resource",
      "description": "Bearer-only resource client. Holds the fortemi-* client roles; it never runs an authorization flow.",
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "fortemi-api",
        "fortemi-mcp"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "fortemi-cli",
      "name": "Fortemi CLI",
      "description": "Public client for fortemi-login and agents: loopback PKCE by default, device grant on headless hosts. Scope ceiling excludes admin; see deploy/identity/claim-policy.example.json.",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://127.0.0.1/*"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "true",
        "display.on.consent.screen": "true"
      },
      "defaultClientScopes": [
        "acr",
        "basic",
        "email",
        "fortemi-api",
        "fortemi-mcp",
        "fortemi-tenant",
        "profile",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": []
    },
