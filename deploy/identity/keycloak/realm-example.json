    {
      "name": "fortemi-api",
      "description": "Audience scope for the Fortemi API resource. Requesting it adds aud https://fortemi.example.org.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Access the Fortemi API on your behalf."
      },
      "protocolMappers": [
        {
          "name": "fortemi-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "https://fortemi.example.org",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "fortemi-mcp",
      "description": "Audience scope for the Fortemi MCP resource. Requesting it adds aud https://fortemi.example.org/mcp. Without RFC 8707 resource indicators (experimental in 26.7), this scope is what carries the audience; clients must request it.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Use Fortemi tools through MCP on your behalf."
      },
      "protocolMappers": [
        {
          "name": "fortemi-mcp-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "https://fortemi.example.org/mcp",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "fortemi-tenant",
      "description": "Carries the admin-managed fortemi_tenant_id user attribute into access tokens for multi-tenant deployments. Single-tenant deployments ignore it and use FORTEMI_AUTH_DEFAULT_TENANT instead.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "fortemi-tenant-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "fortemi_tenant_id",
            "claim.name": "fortemi_tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "aggregate.attrs": "false"
          }
        }
      ]
    },
    {
      "name": "fortemi-admin",
      "description": "Fortemi admin scope; assign only to confidential or step-up admin clients, never public CLI/MCP clients (SR-42).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Access the Fortemi API on your behalf."
      },
      "protocolMappers": [
        {
          "name": "fortemi-admin-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "https://fortemi.example.org",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
