{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortemi.dev/contracts/memory-export/1.0.0/record.schema.json",
  "title": "Fortemi memory export record line",
  "description": "One canonical JSON line. Lines are ordered by entity type (collection, note, note_original, note_revised_current, note_tag, link) and then by the canonical JSON text of `key` compared bytewise; each key appears at most once.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity", "key", "op"],
  "properties": {
    "entity": {
      "type": "string",
      "enum": ["collection", "note", "note_original", "note_revised_current", "note_tag", "link"]
    },
    "key": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string"}},
    "op": {"type": "string", "enum": ["upsert", "delete"]},
    "record": {"type": "object"}
  },
  "if": {"properties": {"op": {"const": "upsert"}}},
  "then": {"required": ["record"]},
  "else": {"not": {"required": ["record"]}}
}
